rules_version = '2';

// クライアントからの直接アクセスの規則（Requirement 9.6, 9.7, 15.2）
// - 実際の書き込みは原則として API（Admin SDK、規則の対象外）で行う。
// - ここに書いていないパスは、すべて拒否する（既定で拒否）。
//   sources / chunks / fetchLogs / config / usage / usageUsers / deletionJobs は
//   クライアントから読み書きできない。
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // API だけが変更できるフラグ。クライアントからの作成・変更を拒否する。
    function serverFlags() {
      return ['deleting', 'sensitiveLocked'];
    }

    // 世帯情報・子どもの情報・同意の記録
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(serverFlags());
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverFlags());

      // 要配慮情報: 読み取りは本人のみ（撤回の削除に失敗してロック中は拒否）。
      // 書き込みは API 経由のみで、クライアントからは本人でも拒否する。
      match /sensitive/{docId} {
        allow read: if isOwner(uid)
          && exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)).data.get('sensitiveLocked', false) != true;
        allow write: if false;
      }

      // 申請状況・医療費記録・チャット履歴・通知トークン・お知らせなど
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid) && subcollection != 'sensitive';
      }
    }

    // 制度の構造化情報: 認証済みの読み取りのみ
    match /programs/{programId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
