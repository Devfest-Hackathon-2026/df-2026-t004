# Web（PWA）の設定。コピーして .env.local を作る（.env.local はコミットしない）。
# Firebase の Web 用設定（firebase apps:sdkconfig WEB の値）。空のときは仮のログイン（モック）で動く。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Auth Emulator を使うとき（例: http://127.0.0.1:9099）
VITE_AUTH_EMULATOR_URL=
# API の接続先: mock（ブラウザ内の仮データ）または http（/api/** の本物の API）
VITE_API_MODE=mock
# 手元の API に中継するとき（例: http://127.0.0.1:8080）。VITE_API_MODE=http と一緒に使う
API_PROXY_TARGET=
